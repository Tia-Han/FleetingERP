# 环境配置说明
# 复制 .env.development 或 .env.production 为 .env 并修改对应值
# 也可以通过 NODE_ENV 环境变量自动选择配置文件

# 服务端口
PORT=3000

# 监听地址
HOST=0.0.0.0

# 运行环境: development | production
NODE_ENV=development

# JWT 密钥 — 必须修改为至少 32 位的随机字符串
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=请修改为你的随机密钥

# 初始管理员密码（仅首次初始化数据库时使用）
ADMIN_PASSWORD=admin123

# CORS 允许的前端来源，多个用逗号分隔
# 开发: http://localhost:3000,http://127.0.0.1:3000
# 生产: https://erp.yourdomain.com
CORS_ORIGIN=http://localhost:3000

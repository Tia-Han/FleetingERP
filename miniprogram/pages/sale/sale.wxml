<!--pages/sale/sale.wxml-->
<view class="sale-page">
  <!-- 客户选择 -->
  <view class="customer-row" bindtap="openCustomerPicker">
    <text class="row-label">客户</text>
    <view class="customer-info" wx:if="{{customer}}">
      <text class="customer-name">{{customer.wechat_name || customer.phone}}</text>
      <text class="customer-points">积分 {{customer.points}}</text>
    </view>
    <text class="customer-name placeholder" wx:else>散客（不积分）</text>
    <text class="row-arrow">›</text>
  </view>

  <!-- 场所选择（小字） -->
  <view class="location-row">
    <picker mode="selector" range="{{locations}}" range-key="name" value="{{locationIndex}}" bindchange="onLocationChange">
      <text>门店：{{locations[locationIndex].name}} ▾</text>
    </picker>
  </view>

  <!-- 扫码添加 -->
  <view class="scan-btn" bindtap="scanAdd">
    <text class="scan-icon">📷</text>
    <text>扫码添加商品</text>
  </view>

  <!-- 商品列表 -->
  <view class="items-section" wx:if="{{items.length > 0}}">
    <view class="section-title">商品明细（{{items.length}}）</view>
    <view class="sale-item" wx:for="{{items}}" wx:key="sku_id">
      <view class="si-info">
        <view class="si-name">{{item.product_name}}</view>
        <view class="si-spec">{{item.volume}} {{item.spec_type}} · 库存{{item.current_qty}}</view>
      </view>
      <view class="si-qty">
        <view class="qty-btn" data-index="{{index}}" bindtap="decreaseQty">−</view>
        <text class="qty-num">{{item.quantity}}</text>
        <view class="qty-btn" data-index="{{index}}" bindtap="increaseQty">+</view>
      </view>
      <view class="si-subtotal">¥{{(item.quantity * item.unit_price).toFixed(2)}}</view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{items.length === 0}}">
    <view class="empty-icon">💰</view>
    <view class="empty-text">请扫码或搜索添加商品</view>
  </view>

  <!-- 折扣/积分 -->
  <view class="calc-section" wx:if="{{items.length > 0}}">
    <view class="section-title">折扣与积分</view>

    <!-- 折扣模式 -->
    <view class="discount-modes">
      <view
        class="mode-btn {{discountMode === 'percent' ? 'active' : ''}}"
        data-mode="percent"
        bindtap="onDiscountModeChange"
      >百分比</view>
      <view
        class="mode-btn {{discountMode === 'amount' ? 'active' : ''}}"
        data-mode="amount"
        bindtap="onDiscountModeChange"
      >金额</view>
    </view>

    <view class="discount-input-row">
      <text class="discount-label">
        {{discountMode === 'percent' ? '折扣比例' : '折扣金额'}}
      </text>
      <view class="discount-input-wrap">
        <input
          class="discount-input"
          type="digit"
          placeholder="{{discountMode === 'percent' ? '如 5 表示5%' : '如 40 表示¥40'}}"
          value="{{discountValue}}"
          bindinput="onDiscountInput"
        />
        <text class="discount-unit">{{discountMode === 'percent' ? '%' : '元'}}</text>
      </view>
    </view>

    <!-- 积分抵扣 -->
    <view class="points-row {{customer ? '' : 'disabled'}}">
      <text class="points-label">积分抵扣</text>
      <view class="points-input-wrap">
        <input
          class="points-input"
          type="number"
          placeholder="{{customer ? '输入使用积分' : '请先选择客户'}}"
          value="{{pointsUsed}}"
          disabled="{{!customer}}"
          bindinput="onPointsInput"
        />
        <text class="points-unit">分 = ¥{{pointsValue}}</text>
      </view>
    </view>
  </view>

  <!-- 结算 -->
  <view class="summary-section" wx:if="{{items.length > 0}}">
    <view class="sum-row">
      <text>商品小计</text>
      <text>¥{{subtotal.toFixed(2)}}</text>
    </view>
    <view class="sum-row">
      <text>折扣</text>
      <text>−¥{{discountAmount.toFixed(2)}}</text>
    </view>
    <view class="sum-row">
      <text>积分抵扣</text>
      <text>−¥{{pointsValue}}</text>
    </view>
    <view class="sum-row total">
      <text>实付金额</text>
      <text>¥{{finalAmount}}</text>
    </view>
    <view class="sum-row points-earn">
      <text>本次新增积分</text>
      <text>+{{pointsEarned}}</text>
    </view>
  </view>

  <!-- 支付方式 -->
  <view class="pay-section" wx:if="{{items.length > 0}}">
    <view class="section-title">支付方式</view>
    <view class="pay-methods">
      <view
        class="pay-method {{payMethod === 'wechat' ? 'active' : ''}}"
        data-method="wechat"
        bindtap="onPayMethodChange"
      >微信支付</view>
      <view
        class="pay-method {{payMethod === 'alipay' ? 'active' : ''}}"
        data-method="alipay"
        bindtap="onPayMethodChange"
      >支付宝</view>
      <view
        class="pay-method {{payMethod === 'cash' ? 'active' : ''}}"
        data-method="cash"
        bindtap="onPayMethodChange"
      >现金</view>
      <view
        class="pay-method {{payMethod === 'bank_card' ? 'active' : ''}}"
        data-method="bank_card"
        bindtap="onPayMethodChange"
      >银行卡</view>
    </view>
  </view>

  <!-- 提交 -->
  <view class="submit-bar" wx:if="{{items.length > 0}}">
    <button class="btn-primary" bindtap="submitOrder" disabled="{{submitting}}" loading="{{submitting}}">
      提交订单 ¥{{finalAmount}}
    </button>
  </view>

  <!-- 客户选择弹窗 -->
  <view class="picker-mask" wx:if="{{showCustomerPicker}}" bindtap="closeCustomerPicker"></view>
  <view class="customer-picker {{showCustomerPicker ? 'show' : ''}}" wx:if="{{showCustomerPicker}}">
    <view class="picker-header">
      <text class="picker-title">选择客户</text>
      <text class="picker-close" bindtap="closeCustomerPicker">关闭</text>
    </view>
    <view class="picker-search">
      <input placeholder="搜索手机号或微信名" value="{{customerSearch}}" bindinput="onCustomerSearchInput" />
    </view>
    <view class="picker-list">
      <block wx:if="{{customerLoading}}">
        <view class="picker-loading">搜索中...</view>
      </block>
      <block wx:elif="{{customerList.length === 0 && customerSearch}}">
        <view class="picker-empty">未找到匹配客户</view>
      </block>
      <block wx:else>
        <view
          class="picker-item"
          wx:for="{{customerList}}"
          wx:key="id"
          data-customer="{{item}}"
          bindtap="selectCustomer"
        >
          <view class="pi-name">{{item.wechat_name || item.phone}}</view>
          <view class="pi-phone">{{item.phone || '无手机号'}} · 积分{{item.points}}</view>
        </view>
      </block>
    </view>
    <view class="picker-footer">
      <button class="btn-outline" bindtap="clearCustomer">散客（不积分）</button>
    </view>
  </view>
</view>

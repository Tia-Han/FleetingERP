/* pages/stockInDetail/stockInDetail.wxss */
.page {
  min-height: 100vh;
  background: #f5f7f6;
  padding-bottom: 120rpx;
}

.info-card {
  background: #fff;
  margin: 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.info-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0d9488;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 28rpx;
}

.info-label {
  color: #6b7d7d;
}

.info-value {
  color: #1a2b2b;
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
}

.detail-card {
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.detail-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a2b2b;
  margin-bottom: 16rpx;
}

.item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.item-row:last-child {
  border-bottom: none;
}

.item-info {
  flex: 1;
}

.item-name {
  font-size: 28rpx;
  color: #1a2b2b;
  margin-bottom: 6rpx;
}

.item-spec {
  font-size: 24rpx;
  color: #9bb0b0;
}

.item-right {
  text-align: right;
}

.item-qty {
  font-size: 28rpx;
  font-weight: 600;
  color: #0d9488;
  margin-bottom: 4rpx;
}

.item-cost {
  font-size: 22rpx;
  color: #6b7d7d;
}

.total-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.06);
}

.total-label {
  font-size: 28rpx;
  color: #6b7d7d;
}

.total-amount {
  font-size: 36rpx;
  font-weight: bold;
  color: #0d9488;
}

.empty-state, .loading-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-text, .loading-text {
  font-size: 28rpx;
  color: #9bb0b0;
}

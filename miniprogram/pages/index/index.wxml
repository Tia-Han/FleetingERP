<!--pages/index/index.wxml-->
<view class="home-page">
  <!-- 顶部数据卡 -->
  <view class="home-header">
    <view class="greeting">
      你好，{{userName || '用户'}} 👋
    </view>
    <view class="home-cards">
      <view class="home-card">
        <view class="card-val">{{itemCount === null ? '—' : itemCount}}</view>
        <view class="card-lbl">物品记录数</view>
      </view>
      <view class="home-card warn">
        <view class="card-val">{{alertCount === null ? '—' : alertCount}}</view>
        <view class="card-lbl">预警库存</view>
      </view>

    </view>
  </view>

  <view wx:if="{{loading}}" class="section-title">正在更新数据…</view>
  <view wx:if="{{networkError}}" class="section-title">部分数据加载失败，请重试。<button size="mini" bindtap="onRetry">重试</button></view>

  <!-- 九宫格功能区 -->
  <view class="grid-section">
    <view class="section-title">功能入口</view>
    <view class="nine-grid">
      <view
        class="grid-item"
        wx:for="{{gridItems}}"
        wx:key="text"
        data-path="{{item.path}}"
        data-tab="{{item.tab}}"
        bindtap="onGridTap"
      >
        <view class="grid-icon {{item.iconBg}}">{{item.icon}}</view>
        <view class="grid-text">{{item.text}}</view>
      </view>
    </view>
  </view>
</view>

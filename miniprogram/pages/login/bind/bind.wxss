/* pages/login/bind/bind.wxss */
.bind-container {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f7f6;
}

.bind-info {
  background: #f0fdfa;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
  font-size: 26rpx;
  color: #0d9488;
  line-height: 1.6;
}

.bind-form .input-group {
  margin-bottom: 24rpx;
}

.bind-form .input-label {
  font-size: 26rpx;
  color: #6b7d7d;
  margin-bottom: 8rpx;
  padding: 0 8rpx;
}

.bind-form .input-field {
  width: 100%;
  background: #fff;
  border: 2rpx solid #e0e6e4;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #1a2b2b;
}

.bind-tip {
  margin-top: 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #6b7d7d;
}

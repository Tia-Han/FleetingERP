/* pages/login/login.wxss */
.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 48rpx;
  background: linear-gradient(180deg, #f0fdfa 0%, #f5f7f6 100%);
}

.login-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(13,148,136,0.15);
}
.login-logo image {
  width: 100%;
  height: 100%;
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a2b2b;
  margin-bottom: 12rpx;
}

.login-sub {
  font-size: 26rpx;
  color: #6b7d7d;
  margin-bottom: 64rpx;
  text-align: center;
}

.login-btn-wx {
  width: 80%;
  background: #07c160;
  color: #fff;
  border: none;
  border-radius: 48rpx;
  padding: 28rpx 0;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.login-btn-wx[disabled] {
  background: #ccc;
}

.login-btn-bind {
  width: 80%;
  background: #fff;
  color: #0d9488;
  border: 2rpx solid #0d9488;
  border-radius: 48rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
}

.login-footer {
  margin-top: 48rpx;
  font-size: 22rpx;
  color: #bbb;
  text-align: center;
}

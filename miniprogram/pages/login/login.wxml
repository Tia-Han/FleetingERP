<!--pages/login/login.wxml-->
<view class="login-container">
  <view class="login-logo">
    <image src="/fleeting-logo.jpg" mode="aspectFill"></image>
  </view>
  <text class="login-title">暗香·Fleeting</text>

  <view wx:if="{{errorMessage}}" class="login-error">{{errorMessage}}</view>

  <form wx:if="{{localDevelopment}}" class="account-login" bindsubmit="accountLogin">
    <text>本机测试环境 · 独立测试数据</text>
    <input class="account-input" name="username" placeholder="用户名" value="{{username}}" bindinput="onUsernameInput" />
    <input class="account-input" name="password" placeholder="密码" password value="{{password}}" bindinput="onPasswordInput" />
    <button class="login-btn-account" form-type="submit" disabled="{{loading}}" loading="{{loading}}">{{loading ? '正在登录…' : '登录'}}</button>
  </form>

  <view wx:if="{{!localDevelopment}}" class="divider"><text>或</text></view>

  <button wx:if="{{!localDevelopment}}" class="login-btn-wx" bindtap="wxLogin" disabled="{{loading}}" loading="{{loading}}">
    微信一键登录
  </button>

  <text wx:if="{{!localDevelopment}}" class="login-footer">登录即表示同意用户协议和隐私政策</text>
</view>

/* pages/scan/scan.wxss */
.scan-page {
  min-height: 100vh;
  background: #f5f7f6;
  padding-bottom: 40rpx;
}

.scan-hero {
  background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%);
  color: #fff;
  padding: 64rpx 32rpx 80rpx;
  text-align: center;
}

.scan-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.scan-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.scan-sub {
  font-size: 26rpx;
  opacity: 0.85;
}

.scan-actions {
  padding: 0 24rpx;
  margin-top: -40rpx;
}

.scan-btn {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.scan-btn:active {
  transform: scale(0.99);
  opacity: 0.9;
}

.scan-btn-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.scan-btn.primary .scan-btn-icon { background: #dcfce7; }
.scan-btn.warn .scan-btn-icon { background: #fed7aa; }
.scan-btn.info .scan-btn-icon { background: #dbeafe; }

.scan-btn-text {
  flex: 1;
}

.scan-btn-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a2b2b;
  margin-bottom: 4rpx;
}

.scan-btn-desc {
  font-size: 24rpx;
  color: #6b7d7d;
}

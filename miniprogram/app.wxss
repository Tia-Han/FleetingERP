/* app.wxss — 全局样式 */
page {
  background: #f5f7f6;
  font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #1a2b2b;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

/* 通用按钮 */
.btn-primary {
  background: #0d9488;
  color: #fff;
  border: none;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
}
.btn-primary[disabled] {
  background: #ccc;
  color: #fff;
}
.btn-outline {
  background: #fff;
  color: #0d9488;
  border: 2rpx solid #0d9488;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  text-align: center;
  width: 100%;
}

/* 输入行 */
.input-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #e0e6e4;
  background: #fff;
}
.input-row .label {
  width: 160rpx;
  font-size: 28rpx;
  color: #6b7d7d;
  flex-shrink: 0;
}
.input-row .value {
  flex: 1;
  font-size: 28rpx;
  color: #1a2b2b;
}
.input-row .value.placeholder {
  color: #bbb;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: #f0f2f1;
  border-radius: 12rpx;
  margin: 16rpx;
  padding: 16rpx 24rpx;
}
.search-bar input {
  flex: 1;
  font-size: 28rpx;
  margin-left: 12rpx;
}

/* 筛选 Chip */
.filter-bar {
  display: flex;
  gap: 12rpx;
  padding: 8rpx 16rpx;
  background: #fff;
  border-bottom: 1rpx solid #e0e6e4;
  overflow-x: auto;
  white-space: nowrap;
}
.filter-chip {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: #f0f2f1;
  color: #6b7d7d;
  flex-shrink: 0;
}
.filter-chip.active {
  background: #0d9488;
  color: #fff;
}

/* 标签 */
.badge {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}
.badge-warn { background: #fef3c7; color: #d97706; }
.badge-empty { background: #fee2e2; color: #dc2626; }
.badge-ok { background: #dcfce7; color: #16a34a; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.empty-state .empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.empty-state .empty-text {
  font-size: 28rpx;
  color: #6b7d7d;
}

/* 列表行 */
.list-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #e0e6e4;
}
.list-row .row-info {
  flex: 1;
}
.list-row .row-name {
  font-size: 30rpx;
  font-weight: 500;
}
.list-row .row-sub {
  font-size: 24rpx;
  color: #6b7d7d;
  margin-top: 4rpx;
}

/* pages/customer/customer.wxss */
.cust-page { min-height: 100vh; background: #f5f7f6; }

.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 16rpx 16rpx 8rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.search-bar .search-icon { font-size: 28rpx; color: #6b7d7d; margin-right: 12rpx; }
.search-bar input { flex: 1; font-size: 28rpx; }

.add-bar { padding: 8rpx 16rpx 16rpx; }
.add-btn { padding: 20rpx; font-size: 28rpx; }

.cust-list { padding: 0 16rpx 40rpx; }

.cust-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  gap: 20rpx;
}
.cust-item:active { background: #f9fafb; }

.cust-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #0d9488, #0f766e);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.cust-info { flex: 1; min-width: 0; }
.cust-name { font-size: 30rpx; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cust-phone { font-size: 24rpx; color: #6b7d7d; margin-top: 4rpx; }

.cust-points { text-align: right; flex-shrink: 0; }
.points-val { font-size: 32rpx; font-weight: 700; color: #0d9488; display: block; }
.points-lbl { font-size: 20rpx; color: #6b7d7d; }

.load-more { text-align: center; padding: 24rpx; font-size: 24rpx; color: #6b7d7d; }
.load-more.end { color: #bbb; }

/* 弹窗复用 */
.picker-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 1000; }
.add-dialog {
  position: fixed;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%) scale(0.9);
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  z-index: 1001;
  opacity: 0;
  transition: all 0.2s;
}
.add-dialog.show { opacity: 1; transform: translate(-50%, -50%) scale(1); }
.dialog-title { font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; text-align: center; }
.dialog-input {
  width: 100%;
  padding: 20rpx;
  background: #f5f7f6;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}
.dialog-actions { display: flex; gap: 16rpx; margin-top: 16rpx; }
.dialog-actions button { flex: 1; font-size: 28rpx; padding: 18rpx; }
